#!/bin/bash
# codex-retry — auto-retry the "model is at capacity" error in the ChatGPT/Codex desktop app.
#
# Toggle:
#   codex-retry            start if stopped, stop if running
# Other commands:
#   codex-retry start|on   start the background daemon
#   codex-retry stop|off   stop it
#   codex-retry status     show status and recent log lines
#   codex-retry log        follow the daemon log (Ctrl-C to quit)
#   codex-retry sweep      process hidden failed sessions once, right now
#   codex-retry threads    list known threads from the local app-server (debug)
#   codex-retry doctor     self-check (permissions, app, windows, daemon)
#   codex-retry restart
#   codex-retry version
#
# Environment:
#   CODEX_RETRY_LANG=en|zh            UI language (defaults to the system locale)
#   CODEX_RETRY_IDLE=10               seconds of user idle before clicking background windows
#   CODEX_RETRY_COOLDOWN=8            minimum seconds between clicks in the same window
#   CODEX_RETRY_INTERVAL=2            scan interval in seconds
#   CODEX_RETRY_SWEEP=0               disable retrying hidden sidebar sessions
#   CODEX_RETRY_SWEEP_IDLE=15         idle seconds before a hidden-session sweep
#   CODEX_RETRY_SWEEP_EVERY=60        minimum seconds between sweeps
#   CODEX_RETRY_SWEEP_COOLDOWN=120    per-session cooldown between hidden retries
#   CODEX_RETRY_SWEEP_RECENT_MIN=120  only sweep sessions updated within this many minutes

set -u

BASE="${CODEX_RETRY_HOME:-$HOME/.local/share/codex-retry}"
BIN="$BASE/retry_daemon"
STATE="${CODEX_RETRY_STATE:-$HOME/.local/state/codex-retry}"
LOG="$STATE/daemon.log"

IDLE="${CODEX_RETRY_IDLE:-10}"
COOLDOWN="${CODEX_RETRY_COOLDOWN:-8}"
INTERVAL="${CODEX_RETRY_INTERVAL:-2}"
SWEEP_IDLE="${CODEX_RETRY_SWEEP_IDLE:-15}"
SWEEP_EVERY="${CODEX_RETRY_SWEEP_EVERY:-60}"
SWEEP_COOLDOWN="${CODEX_RETRY_SWEEP_COOLDOWN:-120}"
SWEEP_RECENT_MIN="${CODEX_RETRY_SWEEP_RECENT_MIN:-120}"

mkdir -p "$STATE" 2>/dev/null || true

# ---------- i18n ----------
ui_lang="${CODEX_RETRY_LANG:-}"
if [ -z "$ui_lang" ]; then
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *zh*|*ZH*) ui_lang=zh ;;
    *) ui_lang=en ;;
  esac
fi
t() { # t <english> <chinese>
  if [ "$ui_lang" = "zh" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}
say() { printf '%s\n' "$*"; }
die() { printf '%s\n' "$*" >&2; exit 1; }

usage() {
  if [ "$ui_lang" = "zh" ]; then
    cat <<'EOF'
codex-retry — ChatGPT / Codex 桌面端满载自动重试

  codex-retry            开关：没运行就启动；正在运行就停止
  codex-retry start      启动
  codex-retry stop       停止
  codex-retry status     查看状态
  codex-retry log        跟踪日志（Ctrl-C 退出）
  codex-retry sweep      立即处理一次隐藏的满载会话（调试用）
  codex-retry threads    列出本地 app-server 的会话（调试用）
  codex-retry doctor     自检（权限 / ChatGPT / 窗口 / daemon）
  codex-retry restart    重启
  codex-retry version    版本

环境变量：
  CODEX_RETRY_LANG=en|zh            界面语言（默认跟随系统）
  CODEX_RETRY_IDLE=10               用户空闲多少秒后才点后台窗口
  CODEX_RETRY_COOLDOWN=8            同一窗口两次点击的最小间隔秒数
  CODEX_RETRY_INTERVAL=2            扫描间隔秒数
  CODEX_RETRY_SWEEP=0               关闭「隐藏会话」自动重试
  CODEX_RETRY_SWEEP_IDLE=15         扫描隐藏会话前的空闲秒数
  CODEX_RETRY_SWEEP_EVERY=60        两次隐藏会话扫描的最小间隔
  CODEX_RETRY_SWEEP_COOLDOWN=120    同一隐藏会话两次重试的最小间隔
  CODEX_RETRY_SWEEP_RECENT_MIN=120  只处理最近多少分钟内更新过的隐藏会话
EOF
  else
    cat <<'EOF'
codex-retry — auto-retry "model is at capacity" in the ChatGPT/Codex desktop app

  codex-retry            toggle: start if stopped, stop if running
  codex-retry start      start the daemon
  codex-retry stop       stop the daemon
  codex-retry status     show status
  codex-retry log        follow the log (Ctrl-C to quit)
  codex-retry sweep      process hidden failed sessions once (debug)
  codex-retry threads    list local app-server threads (debug)
  codex-retry doctor     self-check (permissions / app / windows / daemon)
  codex-retry restart    restart
  codex-retry version    print version

Environment:
  CODEX_RETRY_LANG=en|zh            UI language (defaults to the system locale)
  CODEX_RETRY_IDLE=10               idle seconds before clicking background windows
  CODEX_RETRY_COOLDOWN=8            min seconds between clicks in one window
  CODEX_RETRY_INTERVAL=2            scan interval in seconds
  CODEX_RETRY_SWEEP=0               disable retrying hidden sidebar sessions
  CODEX_RETRY_SWEEP_IDLE=15         idle seconds before a hidden-session sweep
  CODEX_RETRY_SWEEP_EVERY=60        min seconds between sweeps
  CODEX_RETRY_SWEEP_COOLDOWN=120    per-session cooldown between hidden retries
  CODEX_RETRY_SWEEP_RECENT_MIN=120  only sweep sessions updated within this many minutes
EOF
  fi
}

# ---------- helpers ----------
daemon_pids() {
  ps -axo pid=,command= 2>/dev/null | grep -E '[r]etry_daemon( --|$)' | awk '{print $1}'
}

permission_ok() { [ -x "$BIN" ] && "$BIN" --check >/dev/null 2>&1; }

screen_ok() {
  local out
  out=$("$BIN" --probe-screen 2>/dev/null || true)
  [ "$out" = "screen=ok" ]
}

chatgpt_running() { pgrep -x ChatGPT >/dev/null 2>&1; }

open_privacy_pane() {
  open "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension?Privacy_Accessibility" 2>/dev/null || \
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility" 2>/dev/null || true
}

permission_help() {
  say ""
  say "$(t 'Permission needed: Accessibility.' '缺少权限：辅助功能。')"
  say "$(t 'Grant it to the terminal app you run codex-retry from:' '请给运行 codex-retry 的终端 App 授权：')"
  say "  System Settings › Privacy & Security › Accessibility (Device Control and Data Access)"
  say "$(t 'Also grant Screen Recording so the retry button can be located.' '还需要「屏幕录制」，用于定位「重试」按钮。')"
  say "$(t 'Opening System Settings…' '正在打开系统设置…')"
  open_privacy_pane
}

# ---------- commands ----------
start_daemon() {
  [ -x "$BIN" ] || die "$(t "missing $BIN — reinstall with install.sh" "找不到 ${BIN}，请重新运行 install.sh")"
  local existing
  existing=$(daemon_pids | tr '\n' ' ')
  if [ -n "${existing// /}" ]; then
    say "$(t "already running (pid ${existing% })" "已经在运行（pid ${existing% }）")"
    return 0
  fi
  if ! permission_ok; then
    permission_help
    return 2
  fi
  if ! chatgpt_running; then
    say "$(t 'note: ChatGPT is not running yet; the daemon will wait for it.' '提示：ChatGPT 目前没在运行，daemon 会自动等它。')"
  fi
  if ! screen_ok; then
    say "$(t 'warning: Screen Recording is missing; retry buttons cannot be located.' '警告：缺少「屏幕录制」权限，无法定位「重试」按钮。')"
    open_privacy_pane
  fi
  nohup "$BIN" --idle="$IDLE" --cooldown="$COOLDOWN" --interval="$INTERVAL" \
    --sweep-idle="$SWEEP_IDLE" --sweep-every="$SWEEP_EVERY" \
    --sweep-cooldown="$SWEEP_COOLDOWN" --sweep-recent-min="$SWEEP_RECENT_MIN" \
    --log="$LOG" >/dev/null 2>&1 </dev/null &
  sleep 1
  local pid
  pid=$(daemon_pids | head -1)
  if [ -z "$pid" ]; then
    say "$(t "failed to start; see $LOG" "启动失败，见 ${LOG}")"
    return 1
  fi
  say "$(t "✅ auto-retry started (pid $pid)" "✅ 自动重试已开启（pid ${pid}）")"
  say "$(t '   Retry buttons are clicked automatically; run the same command again to stop.' '   出现「重试」按钮会自动点；再运行一次本命令即可关闭。')"
  say "$(t "   log: $LOG" "   日志：${LOG}")"
}

stop_daemon() {
  local pids left
  pids=$(daemon_pids)
  if [ -z "$pids" ]; then
    say "$(t 'daemon is not running.' '自动重试没有在运行。')"
    return 0
  fi
  kill $pids 2>/dev/null
  sleep 0.6
  left=$(daemon_pids)
  if [ -n "$left" ]; then
    kill -9 $left 2>/dev/null
    sleep 0.2
  fi
  say "$(t '🛑 auto-retry stopped.' '🛑 已关闭自动重试。')"
}

status_report() {
  local pids
  pids=$(daemon_pids | tr '\n' ' ')
  if [ -n "${pids// /}" ]; then
    say "$(t "status: running (pid ${pids% })" "状态：运行中（pid ${pids% }）")"
  else
    say "$(t 'status: stopped' '状态：未运行')"
  fi
  if permission_ok; then
    say "$(t 'accessibility: granted' '权限（辅助功能）：已授权')"
  else
    say "$(t 'accessibility: missing' '权限（辅助功能）：缺失')"
  fi
  if screen_ok; then
    say "$(t 'screen recording: ok' '权限（屏幕录制）：正常')"
  else
    say "$(t 'screen recording: missing or no ChatGPT window' '权限（屏幕录制）：缺失或没有 ChatGPT 窗口')"
  fi
  if chatgpt_running; then
    say "$(t 'ChatGPT: running' 'ChatGPT：运行中')"
  else
    say "$(t 'ChatGPT: not running' 'ChatGPT：未运行')"
  fi
  if [ -f "$LOG" ]; then
    local clicks
    clicks=$(grep -c '] click' "$LOG" 2>/dev/null || true)
    say "$(t "clicks so far: ${clicks:-0}" "累计自动点击：${clicks:-0} 次")"
    say "$(t 'recent log:' '最近日志：')"
    tail -3 "$LOG" | sed 's/^/    /'
    say "$(t "full log: $LOG" "完整日志：${LOG}")"
  else
    say "$(t "log: $LOG (empty)" "日志：${LOG}（暂无）")"
  fi
}

doctor() {
  say "$(t '— codex-retry self-check —' '— codex-retry 自检 —')"
  if [ -x "$BIN" ]; then
    say "$(t "binary: $BIN ✓" "程序：${BIN} ✓")"
  else
    say "$(t "binary: missing ✗" "程序：缺失 ✗")"
  fi
  if permission_ok; then
    say "$(t 'accessibility: granted ✓' '权限（辅助功能）：已授权 ✓')"
  else
    say "$(t 'accessibility: missing ✗' '权限（辅助功能）：缺失 ✗')"
  fi
  if chatgpt_running; then
    say "$(t 'ChatGPT: running ✓' 'ChatGPT：运行中 ✓')"
    local wins
    wins=$(osascript -e 'tell application "System Events" to tell process "ChatGPT" to count windows' 2>/dev/null || true)
    [ -n "$wins" ] && say "$(t "ChatGPT windows: $wins" "ChatGPT 窗口数：${wins}")"
  else
    say "$(t 'ChatGPT: not running ✗' 'ChatGPT：未运行 ✗')"
  fi
  if screen_ok; then
    say "$(t 'screen recording: ok ✓' '权限（屏幕录制）：正常 ✓')"
  else
    say "$(t 'screen recording: missing ✗ (grant it to the terminal)' '权限（屏幕录制）：缺失 ✗（请给终端授权）')"
  fi
  local dps
  dps=$(daemon_pids | tr '\n' ' ')
  say "$(t "daemon: ${dps:-stopped}" "daemon：${dps:-未运行}")"
  if [ -f "$LOG" ]; then
    say "$(t 'recent log:' '日志尾部：')"
    tail -5 "$LOG" | sed 's/^/    /'
  fi
}

toggle_daemon() {
  if [ -n "$(daemon_pids)" ]; then
    stop_daemon
  else
    start_daemon
  fi
}

cmd="${1:-toggle}"
case "$cmd" in
  ""|toggle) toggle_daemon ;;
  start|on) start_daemon ;;
  stop|off) stop_daemon ;;
  status|st) status_report ;;
  log|logs)
    [ -f "$LOG" ] || die "$(t "no log yet: $LOG" "暂无日志：${LOG}")"
    tail -f "$LOG"
    ;;
  sweep) "$BIN" --sweep-once --log="$LOG" ;;
  threads) "$BIN" --list-threads ;;
  restart) stop_daemon; sleep 0.3; start_daemon ;;
  doctor|check) doctor ;;
  version|--version|-v) "$BIN" --version ;;
  help|-h|--help|usage) usage ;;
  *)
    say "$(t "unknown command: $cmd" "未知参数：${cmd}")"
    say ""
    usage
    exit 1
    ;;
esac
